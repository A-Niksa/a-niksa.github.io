import Std

/-!
Circular sorting: explicit cycle-decomposition certificates.
Checked with Lean 4.19.0. All computational proofs use `decide +kernel`.
No `sorry`, new axioms, `native_decide`, or external decision oracle.

FORMAL SCOPE: these theorems certify bijective witnesses and exact cycle
partitions for every shift, with at most four nonempty cycles. The standard
mathematical deduction from cycle counts to transposition distance is in
README.md, not formalized here. This is not a full formalization of the
circular-sorting metric or its general theory.
-/
set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace CircularSorting

-- The list order is one-line permutation notation: p[i] is the image of i.
def shift (n : Nat) (p : List Nat) (k i : Nat) : Nat :=
  (p.getD i 0 + k) % n

-- Check every arrow, including the closing arrow, of a nonempty cycle.
def checkCycle (n : Nat) (p : List Nat) (k : Nat) : List Nat → Bool
  | [] => false
  | a :: rest =>
    ((a :: rest).zip (rest ++ [a])).all
      (fun edge => shift n p k edge.1 == edge.2)

-- Length n and one occurrence of each label 0,...,n-1 check coverage,
-- distinctness, and range simultaneously; no label can be omitted/repeated.
def covers (n : Nat) (labels : List Nat) : Bool :=
  (labels.length == n) &&
  (List.range n).all (fun i => labels.count i == 1)

def isDecomposition (n : Nat) (p : List Nat) (k : Nat)
    (cycles : List (List Nat)) : Bool :=
  (covers n cycles.flatten) &&
  cycles.all (checkCycle n p k)

