theorem permutation42 :
    covers 42 p42 = true := by decide +kernel

theorem all_rotations_certified42 :
    ∀ k : Fin 42,
      isDecomposition 42 p42 k.val (certificates42.getD k.val []) = true ∧
      (certificates42.getD k.val []).length ≤ 4 := by decide +kernel

theorem cycle_profile42 :
    certificates42.map List.length = [3, 4, 3, 4, 3, 2, 3, 4, 3, 4, 3, 2, 3, 4, 3, 4, 3, 4, 3, 2, 3, 4, 3, 2, 3, 2, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 2] := by decide +kernel

theorem four_cycles_attained42 :
    (certificates42.getD 1 []).length = 4 := by decide +kernel

theorem certified_min_cost42 :
    ((certificates42.map (fun cycles => 42 - cycles.length)).foldl Nat.min 42)
      = 38 := by decide +kernel

